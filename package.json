{
	"name": "obsidian-cloudflare-r2-sync",
	"version": "1.0.3",
	"description": "Sync local note images to Cloudflare R2.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"type": "tsc --noEmit --skipLibCheck",
		"check": "pnpm type && pnpm lint && pnpm build",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"release": "bash release.sh",
		"version": "node version-bump.mjs && git add manifest.json versions.json README.md",
		"lint": "eslint main.ts ./src/",
		"lint:fix": "eslint main.ts ./src/ --fix"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"plugin"
	],
	"author": "imaikosuke",
	"authorUrl": "https://github.com/imaikosuke",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"esbuild": "0.28.2",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"obsidian": "^1.14.4",
		"tslib": "2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1164.0"
	}
}
